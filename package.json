{
  "name": "chatter",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/check.mjs install",
    "check": "node scripts/check.mjs push",
    "check:commit": "node scripts/check.mjs commit",
    "check:push": "node scripts/check.mjs push",
    "test:checks": "node --test scripts/check.test.mjs",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "restart": "node scripts/stop.mjs && node scripts/start.mjs",
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:chat-server": "npm run dev --workspace apps/chat-server",
    "dev:web": "npm run dev --workspace apps/web",
    "test:chat-server": "npm test --workspace apps/chat-server",
    "test:web": "npm test --workspace apps/web --",
    "test:web:unit": "npm run test:unit --workspace apps/web --",
    "test:web:ui": "npm run test:ui --workspace apps/web --",
    "test:web:watch": "npm run test:watch --workspace apps/web --",
    "test:web:e2e": "npm run test:e2e --workspace apps/web --",
    "test:web:e2e:smoke": "npm run test:e2e:smoke --workspace apps/web --",
    "test:web:e2e:ui": "npm run test:e2e:ui --workspace apps/web --",
    "test:timings": "node apps/web/scripts/testTimings.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "audit-ci --config audit-ci.jsonc",
    "loadtest": "npm run loadtest --workspace apps/chat-server --",
    "crowd": "node scripts/crowd.mjs",
    "crowd:pause": "node scripts/crowdControl.mjs pause",
    "crowd:resume": "node scripts/crowdControl.mjs resume",
    "crowd:stop": "node scripts/crowdControl.mjs stop",
    "seed:prod": "node scripts/seedProd.mjs",
    "env:push": "node scripts/pushEnv.mjs"
  },
  "devDependencies": {
    "audit-ci": "^7.1.0",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "^3.4.2",
    "wait-on": "^9.5.1"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "npm exec --workspace apps/web -- eslint --fix --no-warn-ignored",
    "apps/chat-server/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "npm exec --workspace apps/chat-server -- eslint --fix --no-warn-ignored",
    "apps/admin/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "npm exec --workspace apps/admin -- eslint --fix --no-warn-ignored",
    "*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "braces": "^3.0.3",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4",
    "undici": "^7.30.1",
    "dompurify": "^3.4.17"
  }
}
