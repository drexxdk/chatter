{
  "name": "chatter",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "restart": "node scripts/stop.mjs && node scripts/start.mjs",
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:chat-server": "npm run dev --workspace apps/chat-server",
    "dev:web": "npm run dev --workspace apps/web",
    "test:chat-server": "npm test --workspace apps/chat-server",
    "test:web": "npm test --workspace apps/web",
    "test:web:e2e": "npm run test:e2e --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "audit-ci --config audit-ci.jsonc",
    "loadtest": "npm run loadtest --workspace apps/chat-server --",
    "crowd": "node scripts/crowd.mjs",
    "crowd:pause": "node scripts/crowdControl.mjs pause",
    "crowd:resume": "node scripts/crowdControl.mjs resume",
    "crowd:stop": "node scripts/crowdControl.mjs stop",
    "seed:prod": "node scripts/seedProd.mjs",
    "env:push": "node scripts/pushEnv.mjs"
  },
  "devDependencies": {
    "audit-ci": "^7.1.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.4.2",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "braces": "^3.0.3",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4",
    "undici": "^7.30.1",
    "dompurify": "^3.4.17"
  }
}
