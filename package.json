{
  "name": "chatter",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:chat-server": "npm run dev --workspace apps/chat-server",
    "dev:web": "npm run dev --workspace apps/web",
    "test:chat-server": "npm test --workspace apps/chat-server",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "braces": "^3.0.3",
    "esbuild": "^0.25.0",
    "undici": "^7.30.0",
    "dompurify": "^3.4.16"
  }
}
