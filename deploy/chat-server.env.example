# The chat-server in production. Copy to deploy/chat-server.env (not committed) and fill in.
# PORT, REDIS_URL and PAYLOAD_URL are set by docker-compose.prod.yml. Every other setting, with what it does, is in
# apps/chat-server/.env.example; the ones that matter here:

# Made by the seed (docker compose ... run --rm admin-tools); it prints the key once.
PAYLOAD_SERVICE_API_KEY=

# Make each with: openssl rand -hex 32. Changing BAN_HASH_SALT invalidates existing bans.
BAN_HASH_SALT=
AUTH_TOKEN_SECRET=

# Exactly the address of the web client, as the browser sends it: no path, no trailing slash.
WEB_ORIGIN=https://chatter.example.pages.dev

# Cloudflare Turnstile Managed widget for the web hostname. Configure both to enable human verification.
# Use real keys here; test keys are refused in production. Only the site key is exposed to the browser.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The proxies in front of the chat-server: 1 with CADDY_MODE=direct, 2 with CADDY_MODE=cloudflare.
TRUST_PROXY_HOPS=1

# Live connections allowed per client IP (this process only). Remove the line for no limit.
MAX_CONNECTIONS_PER_IP=20

# Sign in with Google, Facebook or Discord (see "Accounts" in deploy/runbook.md). A provider is on when both of its
# settings are filled in; leave a pair empty to keep that provider off. PUBLIC_API_URL is this server's own address, an
# origin with no path or trailing slash, and the redirect address at each provider is <PUBLIC_API_URL>/auth/<provider>/callback.
PUBLIC_API_URL=https://chatter-api.example.duckdns.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
