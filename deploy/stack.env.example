# Read by docker compose: docker compose --env-file deploy/stack.env -f docker-compose.prod.yml ...
# Copy to deploy/stack.env (not committed) and fill in.

# The two addresses the stack answers on; both must point at this machine.
API_HOST=chatter-api.example.org
ADMIN_HOST=chatter-admin.example.org

# direct, or cloudflare once the domain is proxied by Cloudflare (see deploy/caddy/cloudflare.Caddyfile).
CADDY_MODE=direct

# Where the images come from, and which version.
IMAGE_PREFIX=ghcr.io/drexxdk/chatter
TAG=latest

# Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=
