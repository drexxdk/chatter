# The first super-admin, for the seed (bash deploy/seed.sh). Copy to deploy/seed.env (not committed) and fill in.
# Only the one-off admin-tools service reads this file, never the running admin. The seed creates the account only when
# the database has no admins yet, so keeping the file makes a fresh start easy and does nothing on a database that is
# already set up. Changing the password in the admin panel does not change this file.

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
