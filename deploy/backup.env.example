# Settings for deploy/backup.sh. Copy to deploy/backup.env (not committed) and fill in.
# rclone reads RCLONE_CONFIG_<NAME>_* as the settings of a remote called <NAME>, so no rclone config file is needed.

# Cloudflare R2: create a bucket and an API token with write access to it (Cloudflare dashboard, R2).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# remote:bucket
RCLONE_REMOTE=r2:chatter-backups

# Dumps older than this many days are removed.
KEEP_DAYS=30
