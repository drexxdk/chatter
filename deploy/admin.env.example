# The admin in production. Copy to deploy/admin.env (not committed) and fill in.
# DATABASE_URL is built by docker-compose.prod.yml from POSTGRES_PASSWORD.

# Make one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Only for the seed (docker compose ... run --rm admin-tools), which creates the first super-admin, the sample rooms and
# the chat-server's service account. Remove both lines afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
