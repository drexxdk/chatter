# Base URL of apps/chat-server (REST /rooms and the Socket.IO endpoint)
VITE_CHAT_SERVER_URL=http://localhost:4000

# GIPHY API key for the GIF button (https://developers.giphy.com/dashboard). Without it there is no GIF button.
VITE_GIPHY_API_KEY=

# Legal-page fallback; published legal text uses the address set in the admin.
VITE_CONTACT_EMAIL=

# Optional staff-menu admin link override. Defaults to localhost:3000/admin in development and the live admin in production.
# VITE_ADMIN_URL=https://chatter-drexx-admin.duckdns.org/admin
