# Base URL of apps/chat-server (REST /rooms and the Socket.IO endpoint)
VITE_CHAT_SERVER_URL=http://localhost:4000

# GIPHY API key for the GIF button (https://developers.giphy.com/dashboard). Without it there is no GIF button.
VITE_GIPHY_API_KEY=

# Only shown on the terms pages when the text itself cannot be loaded; the address in the text is set in the admin.
VITE_CONTACT_EMAIL=
