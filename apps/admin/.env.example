DATABASE_URL=postgres://chatter:chatter_dev_password@127.0.0.1:5432/chatter
# At least 16 characters, e.g. `openssl rand -hex 32`. The app refuses to start with this placeholder.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used only by the one-time seed script (npm run seed) to create the first super-admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
