# Server
PORT=4000

# Shared local-dev infrastructure (see root docker-compose.yml)
REDIS_URL=redis://localhost:6379

# apps/admin (Payload) connection
PAYLOAD_URL=http://localhost:3000
# Generated by `npm run seed --workspace apps/admin` for the chat-server service account
PAYLOAD_SERVICE_API_KEY=

# Origin of the chat client (apps/web), for CORS and Socket.IO
WEB_ORIGIN=http://localhost:5173
