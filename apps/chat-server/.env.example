# Server
PORT=4000

# Shared local-dev infrastructure (see root docker-compose.yml)
REDIS_URL=redis://localhost:6379

# apps/admin (Payload) connection
PAYLOAD_URL=http://localhost:3000
# Generated by `npm run seed --workspace apps/admin` for the chat-server service account
PAYLOAD_SERVICE_API_KEY=

# Salt for hashing client IPs into ban identifiers; changing it invalidates existing bans
BAN_HASH_SALT=

# Origin of the chat client (apps/web), for CORS and Socket.IO
WEB_ORIGIN=http://localhost:5173

# Guests who send no events for this long are disconnected to free their seat (default 15 minutes, 0 disables)
INACTIVITY_TIMEOUT_MS=900000

# How often rooms and bans are re-read from Payload (default 30 seconds)
SYNC_INTERVAL_MS=30000

# Redis pub/sub channel prefix for Socket.IO. Servers sharing a Redis instance and this key act as one cluster,
# so give a separate instance (e.g. the e2e tests) its own key.
SOCKET_ADAPTER_KEY=socket.io

# Live connections allowed per client IP, per server process (default 10, 0 disables)
MAX_CONNECTIONS_PER_IP=10

# How many reverse proxies you control sit in front of this server (default 0 = none).
# Only then is X-Forwarded-For used to find the client IP; set it higher than reality and clients can forge their IP.
TRUST_PROXY_HOPS=0
