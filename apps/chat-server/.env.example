# Server (a whole number from 1 to 65535; anything else stops the server at startup)
PORT=4000

# Shared local-dev infrastructure (see root docker-compose.yml)
REDIS_URL=redis://localhost:6379

# apps/admin (Payload) connection
PAYLOAD_URL=http://localhost:3000
# Generated by `npm run seed --workspace apps/admin` for the chat-server service account
PAYLOAD_SERVICE_API_KEY=

# Salt for hashing client IPs into ban identifiers (at least 16 characters, e.g. `openssl rand -hex 32`).
# Changing it invalidates existing bans.
BAN_HASH_SALT=

# Origin of the chat client (apps/web), for CORS and Socket.IO. Exactly what the browser sends: no path, no trailing slash.
WEB_ORIGIN=http://localhost:5173

# Guests who send no events for this long (in milliseconds) are disconnected to free their seat.
# Remove the line (or leave it empty) for the default of 15 minutes. It must be a positive whole number:
# anything else, including 0, stops the server at startup. There is no way to switch the check off.
INACTIVITY_TIMEOUT_MS=900000

# How often rooms and bans are re-read from Payload (default 30 seconds). Must be a positive whole number of milliseconds.
SYNC_INTERVAL_MS=30000

# Seconds a guest must wait between messages in rooms whose slow mode is empty in Payload (default 10).
# Must be a positive whole number; there is no way to switch it off.
DEFAULT_SLOW_MODE_SECONDS=10

# How many times one client IP may fetch the room list (GET /rooms) per minute (default 60). Positive whole number.
ROOMS_RATE_LIMIT_PER_MINUTE=60

# Redis pub/sub channel prefix for Socket.IO. Servers sharing a Redis instance and this key act as one cluster,
# so give a separate instance (e.g. the e2e tests) its own key.
SOCKET_ADAPTER_KEY=socket.io

# Live connections allowed per client IP, per server process. Remove the line (or leave it empty) for no limit.
# Anything other than a positive whole number stops the server at startup.
MAX_CONNECTIONS_PER_IP=10

# How many reverse proxies you control sit in front of this server (default 0 = none). Must be a whole number, 0 or more.
# Only then is X-Forwarded-For used to find the client IP; set it higher than reality and clients can forge their IP.
TRUST_PROXY_HOPS=0

# Recent messages kept per room in Redis, handed to guests who join or reconnect (default 50, at most 200).
ROOM_HISTORY_SIZE=50

# A room's history is deleted this many seconds after its last message (default 3600, at most 604800).
ROOM_HISTORY_TTL_SECONDS=3600

# Signs the sessions of moderators who sign in to the chat (at least 32 characters, e.g. `openssl rand -hex 32`).
# Leave it unset and nobody can sign in as a moderator; everything else works.
AUTH_TOKEN_SECRET=
